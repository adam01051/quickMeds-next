      "items": {
        "faq-find-pharmacy-near-me": {
          "subject": "Yonimdagi dorixonani qanday topaman?",
          "content": "Dorixonalar sahifasida nom, manzil, hudud, dorixona turi, yetkazib berish, sug'urta yordami va mavjud bo'lsa ochiq holati bo'yicha qidiring."
        },
        "faq-search-name-address": {
          "subject": "Dorixona nomi yoki manzili bo'yicha qidira olamanmi?",
          "content": "Ha. Qidiruv maydoniga dorixona nomi, ko'cha, tuman yoki mo'ljal kiriting, QuickMeds mavjud dorixona profillarini moslaydi."
        },
        "faq-account-needed-browse": {
          "subject": "Dorixonalarni ko'rish uchun hisob kerakmi?",
          "content": "Yo'q. Ommaviy dorixona ro'yxatlarini tizimga kirmasdan ko'rishingiz mumkin. Xabar yuborish, kuzatish, yoqtirish va izoh qoldirish kabi ayrim amallar hisob talab qiladi."
        },
        "faq-open-now": {
          "subject": "\"Hozir ochiq\" nimani anglatadi?",
          "content": "Ochiq holati dorixonaning saqlangan ish vaqti va vaqt mintaqasi asosida hisoblanadi. Ish vaqti kiritilmagan bo'lsa, QuickMeds dorixonani ochiq deb hisoblamaydi."
        },
        "faq-delivery": {
          "subject": "Dorixona yetkazib berishini qanday bilaman?",
          "content": "Dorixona kartalari va batafsil sahifalarda yetkazib berish mavjudligi hamda kiritilgan bo'lsa UZSdagi yetkazib berish narxi ko'rsatiladi."
        },
        "faq-insurance": {
          "subject": "Dorixona sug'urtani qabul qilishini qanday bilaman?",
          "content": "Dorixona kartasi yoki batafsil sahifadagi sug'urta ma'lumotini tekshiring. Borishdan oldin dorixona bilan bevosita tasdiqlang."
        },
        "faq-stock-prices": {
          "subject": "QuickMeds dori mavjudligi yoki narxlarni tasdiqlay oladimi?",
          "content": "Hozircha yo'q. QuickMeds dorixonalarni topish va ular bilan bog'lanishga yordam beradi. Joriy dori mavjudligi va narxlarini tasdiqlash uchun dorixonaga yozing yoki qo'ng'iroq qiling."
        },
        "faq-contact-pharmacy": {
          "subject": "Dorixona bilan qanday bog'lanaman?",
          "content": "Dorixona batafsil sahifasini oching va xabar formasi yoki mavjud aloqa ma'lumotlaridan foydalaning."
        },
        "faq-message-location": {
          "subject": "Dorixonaga yozgan xabarlarim qayerda ko'rinadi?",
